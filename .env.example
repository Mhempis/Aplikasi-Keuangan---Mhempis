# Database — PostgreSQL (WAJIB). Contoh:
#   lokal : postgresql://keuangan:password@127.0.0.1:5432/keuangan?schema=public
#   server: postgresql://keuangan:password@127.0.0.1:5432/keuangan?schema=public
DATABASE_URL="postgresql://keuangan:ganti-password@127.0.0.1:5432/keuangan?schema=public"

# Kunci penandatangan cookie sesi — WAJIB minimal 32 karakter, JANGAN dibagikan.
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"

# URL publik aplikasi ini (dipakai untuk redirect OAuth & flag cookie Secure)
APP_URL="http://localhost:3000"

# Login Google (opsional). Kosongkan kalau belum mau dipakai.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Kredensial akun contoh saat menjalankan scripts/seed-demo.mjs
SEED_EMAIL="budi@keluarga.com"
SEED_PASSWORD="ganti-password-demo"
