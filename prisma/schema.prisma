datasource db {
  // CATATAN PRODUKSI: SQLite hanya untuk lokal/uji. Di serverless (Vercel) filesystem
  // bersifat sementara, jadi ganti ke PostgreSQL: provider = "postgresql"
  // + set DATABASE_URL ke connection string Postgres.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  image     String?
  provider  String   @default("credentials")
  createdAt DateTime @default(now())

  accounts     Account[]
  transactions Transaction[]
  savingsGoals SavingsGoal[]
  categories   CategoryItem[]
}

model Account {
  id        String   @id
  name      String
  balance   Float
  updatedAt DateTime @default(now()) @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  savingsGoals SavingsGoal[]

  @@index([userId])
}

model Transaction {
  id          String   @id
  date        DateTime @default(now())
  description String
  category    String
  amount      Float
  type        String
  status      String   @default("completed")
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([accountId])
}

model SavingsGoal {
  id            String    @id
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  category      String
  color         String    @default("#3B82F6")
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CategoryItem {
  id     String @id @default(cuid())
  name   String
  type   String
  color  String @default("#3B82F6")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name, type])
  @@index([userId])
}
